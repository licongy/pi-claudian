{
  "name": "pi-claudian",
  "version": "0.1.0",
  "description": "A monorepo of independently-published Pi extensions for collaborating with Claudian.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Licong Yang",
    "email": "licong.yang@icloud.com",
    "url": "https://github.com/licongy"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/licongy/pi-claudian.git"
  },
  "homepage": "https://github.com/licongy/pi-claudian#readme",
  "bugs": {
    "url": "https://github.com/licongy/pi-claudian/issues"
  },
  "keywords": [
    "pi",
    "claudian",
    "pi-extension",
    "monorepo"
  ],
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "changeset": "changeset",
    "version": "node scripts/check-clean.mjs && changeset version",
    "release": "node scripts/check-clean.mjs && changeset publish",
    "release:one": "node scripts/release-one.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
